[Problem]
Name = floodmar_pond5m_head5cm_4d6d_720h
InitialOxygenProfileFile = oxygen_initial_2880.dat
PondRadius = 5.0
PondDepth = 0.5
PondStartupRampTime = 43200
PondInjectionHead = 5
PondDrainageHead = -25
AtmosphericOxygenDiffusionCoefficient = 1e-6
AtmosphericGasPressureFactor = 1.0

[Grid]
# Physical integer tags remain in the elements, but the names block is
# intentionally absent for compatibility with the WSL/Linux UGGrid reader.
File = floodmar_pond5m_nonames.msh
Verbose = true

[TimeLoop]
# Three 4 d recharge / 6 d drainage cycles, including 5 h transition ramps.
TEnd = 2592000
DtInitial = 1.08
MaxTimeStepSize = 600
OutputInterval = 21600

[Newton]
MaxRelativeShift = 1e-5
MaxSteps = 40
MaxTimeStepDivisions = 15
TargetSteps = 6
UseLineSearch = false
EnableChop = true
ChopMaxPressureChange = 2e4
ChopMaxSaturationChange = 0.10
ChopMaxLiquidMoleFractionChange = 1e-5
ChopMaxGasMoleFractionChange = 0.05
ChopSaturationBuffer = 0

[PrimaryVariableSwitch]
GasPhaseHoldIterations = 48
GasDisappearanceTolerance = 0.01
GasAppearanceTolerance = 0.02
LiquidAppearanceTolerance = 0.02
AppearanceSaturation = 1e-4
Verbosity = 0

[LinearSolver]
ResidualReduction = 1e-8

[Dispersion]
LongitudinalDispersivity = 0.50
TransverseDispersivity = 0.05
ApplyToGasPhase = false

[Vtk]
AddVelocity = true
Precision = Float64

[SpatialParams]
Temperature = 298.15

[SpatialParams.Sand1]
Swr = 0.12737
Snr = 0.0
VanGenuchtenAlpha = 3.2631e-4
VanGenuchtenN = 3.47614
VanGenuchtenL = 0.5

[SpatialParams.LoamySand]
Swr = 0.11077
Snr = 0.0
VanGenuchtenAlpha = 3.9769e-4
VanGenuchtenN = 2.03252
VanGenuchtenL = 0.5

[SpatialParams.Sand2]
Swr = 0.12576
Snr = 0.0
VanGenuchtenAlpha = 7.2400e-4
VanGenuchtenN = 3.01351
VanGenuchtenL = 0.5

[SpatialParams.Loam]
Swr = 0.13300
Snr = 0.0
VanGenuchtenAlpha = 1.0197e-4
VanGenuchtenN = 1.49217
VanGenuchtenL = 0.5

[SpatialParams.SandyLoam]
Swr = 0.13203
Snr = 0.0
VanGenuchtenAlpha = 2.0394e-4
VanGenuchtenN = 1.40886
VanGenuchtenL = 0.5

[SpatialParams.Sand3]
Swr = 0.11077
Snr = 0.0
VanGenuchtenAlpha = 3.5690e-4
VanGenuchtenN = 2.03252
VanGenuchtenL = 0.5
