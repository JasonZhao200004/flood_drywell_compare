[TimeLoop]
# HYDRUS formal simulation: 720 h.
TEnd = 5184000
# HYDRUS initial step: 0.0003 h = 1.08 s.
DtInitial = 300
# HYDRUS maximum step: 0.1 h = 360 s.
MaxTimeStepSize = 300
# 120 equally spaced print intervals over 720 h = every 6 h.
OutputInterval = 21600

[Grid]
File = /home/zhe_zhao/dumux-work/dumux/dumux-floodmar/test/porousmediumflow/2p2c/floodmar_HYDROFIX2_CORRECTED_full60d/floodmar_pond5m_depth10cm_nonames.msh
Verbose = true

[Problem]
Name = floodmar_HYDROFIX2_CORRECTED_480to1440h
InitialOxygenProfileFile = /home/zhe_zhao/dumux-work/dumux/dumux-floodmar/test/porousmediumflow/2p2c/floodmar_HYDROFIX2_CORRECTED_full60d/oxygenIC_trueStagnantO2_2880h_2d_xO2.dat
AtmosphericOxygenDiffusionCoefficient = 1e-6
AtmosphericGasPressureFactor = 1.0
EnableGravity = true
DrywellStartupRampTime = 1800
DrywellInjectionHead = 5
Cycle1ShutdownStartHours = 96.0
Cycle2ShutdownStartHours = 576.164044805955
Cycle3ShutdownStartHours = 1060.953978421305
EnableGasPhaseOxygenAdvection = true
[Dispersion]
LongitudinalDispersivity = 0.50
TransverseDispersivity = 0.05
ApplyToGasPhase = false

[Vtk]
AddVelocity = true
Precision = Float64
[Output]
PlotFluidMatrixInteractions = false

[LinearSolver]
ResidualReduction = 1e-8

[Newton]
MaxRelativeShift = 1e-4
MaxSteps = 40
MaxTimeStepDivisions = 15
TargetSteps = 6
UseLineSearch = false
EnableChop = true
ChopMaxPressureChange = 2e4
ChopMaxSaturationChange = 0.10
ChopMaxLiquidMoleFractionChange = 1e-5
ChopMaxGasMoleFractionChange = 0.05
ChopSaturationBuffer = 0
[Component]
SolidDensity = 2700
SolidThermalConductivity = 2.8
SolidHeatCapacity = 790

# alpha values converted from 1/cm to 1/Pa:
# alpha_Pa = alpha_cm / 98.0665

[SpatialParams.Sand1]
VanGenuchtenAlpha = 3.2631e-4
VanGenuchtenN = 3.47614
VanGenuchtenL = 0.5
Swr = 0.12737
Snr = 0.0

