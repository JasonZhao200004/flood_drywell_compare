[Problem]
Name = floodmar_pond3m_head5cm_720h
InitialOxygenProfileFile = oxygen_initial_2880.dat
PondStartupRampTime = 3600
AtmosphericOxygenDiffusionCoefficient = 1e-6
AtmosphericGasPressureFactor = 1.0

[Grid]
File = floodmar_pond.msh
Verbose = true

[TimeLoop]
# Three recharge/drainage cycles; all values are seconds.
TEnd = 2592000
DtInitial = 1.08
MaxTimeStepSize = 60
OutputInterval = 21600

[Newton]
MaxRelativeShift = 1e-7
MaxSteps = 18

[LinearSolver]
ResidualReduction = 1e-8

[Vtk]
AddVelocity = true

[SpatialParams]
Temperature = 298.15

[SpatialParams.Sand1]
Swr = 0.12737
Snr = 0.0
VanGenuchtenAlpha = 3.2631e-4
VanGenuchtenN = 3.47614
VanGenuchtenL = 0.5

